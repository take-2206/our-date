   .shell { padding-left: 0 !important; padding-bottom: 84px; }
   .shell:has(.room) { padding-bottom: 0; }
 }
+
+/* ===== NHÂN VẬT TO, ĐI KHẮP SÀN ===== */
+.room .pet-stage { top: 30%; bottom: 150px; height: auto; }
+.room .pet-walker { --depth: 1; width: 168px; height: 218px; bottom: auto; top: 70%; transform: translate(-50%, -100%) scale(var(--depth)); transform-origin: 50% 100%; transition: left .18s linear, top .18s linear; will-change: left, top; }
+.room .pet-chat-bubble { z-index: 5; }
+/* ===== TAB LỊCH / TẤT CẢ BUỔI HẸN ===== */
+.cal-tabs { max-width: 420px; margin: 0 auto 14px; }
+.cal-tabs .btn { flex: 1; min-height: 38px; font-size: 13px; }
